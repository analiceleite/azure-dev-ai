# Repositório Git alvo (o Cursor pode sobrescrever via mcp.json)
GIT_REPO_PATH=
# auto = upstream / fork-point da branch atual (recomendado)
# ou fix/tenant, origin/fix/tenant, origin/main, etc.
GIT_BASE_BRANCH=auto

# Azure DevOps
AZURE_DEVOPS_ORG=OPM-DSA-LA
AZURE_DEVOPS_PROJECT=Level Up
# browser | rest | auto
AZURE_PUBLISH_MODE=browser
# Opcional — necessário para modo rest ou auto com fallback REST
AZURE_DEVOPS_PAT=

# Playwright / navegador
PLAYWRIGHT_USER_DATA_DIR=./.azure-browser-profile
AZURE_BROWSER_HEADLESS=false
PLAYWRIGHT_BROWSER_CHANNEL=msedge
PLAYWRIGHT_PROXY=

# Proxy corporativo (Bosch)
HTTP_PROXY=
HTTPS_PROXY=

# Azure OpenAI (recomendado)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# OpenAI direto (alternativa)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
